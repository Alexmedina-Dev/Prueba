# MotoVerso — Variables de entorno para Seenode
# Copiar este archivo como .env y llenar los valores reales

# ═══════════════════════════════════════════════════════════════
# MySQL — Seenode provee DATABASE_URL automáticamente
# El código prioriza DATABASE_URL sobre las variables individuales
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=mysql://user:password@host:port/dbname

# Variables individuales (solo para desarrollo local con XAMPP)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=motoverso

# JWT
JWT_SECRET=tu_secret_super_largo_y_seguro_aqui

# Puerto del servidor
PORT=3000

# Producción
NODE_ENV=production

# CORS — dominios permitidos (separados por coma)
ALLOWED_ORIGINS=https://www.motoverso.app,https://prueba.seenode.app
