# MotoVerso — Variables de entorno para Hostinger
# Copiar este archivo como .env y llenar los valores reales

# MySQL (configurar en hPanel → Databases → MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=uXXXXXXX_motoverso
DB_PASSWORD=tu_password_aqui
DB_NAME=uXXXXXXX_motoverso

# JWT
JWT_SECRET=tu_secret_super_largo_y_seguro_aqui

# Puerto del servidor
PORT=3000

# Producción
NODE_ENV=production

# Dominio permitido para CORS (tu dominio real en Hostinger)
ALLOWED_ORIGIN=https://tudominio.com
